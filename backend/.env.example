# Database Configuration
# Option A: Full connection string (Recommended for Supabase, Neon, Render)
# DATABASE_URL=postgresql://postgres.[project-ref]:[your-password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Option B: Individual parameters
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hotel_booking
DB_USER=postgres
DB_PASS=your_database_password
DB_SSL=false

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_here

# Google OAuth
GOOGLE_CLIENT_ID=799209083609-g7o38t31s1jotiosi8lafkbf2smggc92.apps.googleusercontent.com

# Server Configuration
PORT=5000

# Exchange Rate API Key (from exchangerate-api.com)
EXCHANGE_API_KEY=8b559ef9b53bf8faa09c94f7

# Email Configuration
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_public_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

